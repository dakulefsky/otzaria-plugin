{
  "name": "otzaria-test-bridge",
  "version": "0.3.0",
  "private": true,
  "description": "Local MCP testing companion for Otzaria plugins",
  "type": "module",
  "bin": {
    "otzaria-test-bridge": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "npm run build",
    "test:policy": "node tests/policy.test.js",
    "test:e2e": "node tests/e2e.js",
    "test": "npm run test:policy && npm run test:e2e && npm run test:mcp",
    "test:mcp": "node tests/mcp.e2e.js",
    "pack": "python3 scripts/pack-plugin.py"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
